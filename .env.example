# Select one OpenAI-compatible provider. GROQ_API_KEY takes precedence when present.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Gemini remains supported when GROQ_API_KEY is not configured.
# ANNAOPS_GEMINI_API_KEY=your_gemini_api_key_here
# ANNAOPS_GEMINI_MODEL=gemini-3.6-flash
# ANNAOPS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Application settings
ANNAOPS_DATABASE_PATH=data/annaops.db
ANNAOPS_TIMEZONE=Asia/Kolkata
ANNAOPS_DEMO_MODE=true
ANNAOPS_MAX_DISPATCH_ATTEMPTS=2
ANNAOPS_ESCALATION_WINDOW_MINUTES=30
ANNAOPS_LLM_TIMEOUT_SECONDS=20
ANNAOPS_AGENT_MAX_ITERATIONS=3
ANNAOPS_LLM_MAX_RETRIES=2
ANNAOPS_LLM_CONCURRENCY_LIMIT=2
ANNAOPS_LLM_BUDGET_PER_DONATION=5
ANNAOPS_LLM_BUDGET_EXTENSION=2
